{
  "uid": "warehouse",
  "title": "Smart Warehouse",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Consumer lag по партициям",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "warehouse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (partition) (consumer_lag)",
          "legendFormat": "partition {{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Throughput — событий в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "warehouse-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(events_processed_total{job=\"warehouse-consumer\"}[1m]))",
          "legendFormat": "{{event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Ошибки записи в Cassandra",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "warehouse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cassandra_write_errors_total{job=\"warehouse-consumer\"}[1m]))",
          "legendFormat": "write errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Время обработки p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "warehouse-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(event_processing_duration_seconds_bucket{job=\"warehouse-consumer\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}

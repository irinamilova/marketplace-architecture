@startuml
!pragma layout smetana
!include <C4/C4_Container>
title B — Temporal critical-delivery workflows (C4 Container)
LAYOUT_LEFT_RIGHT()
Person(customer, "Customer", "Receives notifications; controls preferences")
System_Ext(bank, "Bank services", "Business transaction + source outbox")
System_Ext(channels, "Channel providers", "FCM/APNs, SMS-A / SMS-B, email")
System_Ext(obs, "Operations and support tooling", "Prometheus, Grafana, Loki, Alertmanager; audit views")
System_Boundary(platform, "Notification Platform — option B") {
  Container(api, "Notification API + Outbox Relay", "Go / HTTPS", "Durable admission; publish with stable IDs")
  ContainerDb(ledger, "Platform ledger", "PostgreSQL 16 / sync replicas", "Notification, attempts, inbox/outbox, policy, encrypted payload, audit")
  ContainerQueue(kafka, "Class-isolated event streams", "Apache Kafka / RF=3", "Critical requests; service and marketing requests")
  Container(starter, "Workflow Starter + Reconciler", "Go / Temporal SDK", "Start by notification ID; recover missing executions")
  Container(temporal, "Temporal Server", "Self-hosted / three AZ", "Durable history, task queues, timers, Signals")
  ContainerDb(persistence, "Temporal persistence + visibility", "Dedicated PostgreSQL 16 / sync replicas", "Separate from application ledger; durable workflow state")
  Container(workers, "Delivery worker", "Go / Temporal SDK", "One deployable type: workflow/activity roles; isolated pools")
  Container(receipts, "Receipt API + Signal Relay", "Go / HTTPS / Temporal SDK", "Persist inbox and evidence before signaling; retry Signals")
  Container(policy, "Policy and template service", "Go / HTTPS", "Preferences, consent, mandatory categories, templates")
  Container(campaign, "Campaign + noncritical workers", "Go", "Batched fanout; no Temporal per marketing message")
}
Rel_R(bank, api, "Submit / retry", "HTTPS")
Rel_D(api, ledger, "Intake / status / outbox", "SQL")
Rel_R(api, kafka, "Relay requests", "Kafka protocol")
Rel_R(kafka, starter, "Critical requests", "Kafka protocol")
Rel_R(starter, temporal, "StartWorkflow", "gRPC")
Rel(starter, ledger, "Reconcile", "SQL")
Rel_D(temporal, persistence, "History / tasks / visibility", "SQL")
Rel(workers, temporal, "Poll tasks; complete activities", "gRPC")
Rel(workers, ledger, "Attempts / evidence", "SQL")
Rel_U(workers, policy, "Read policy", "HTTPS")
Rel_R(workers, channels, "Send / status", "HTTPS")
Rel_R(channels, customer, "Push / SMS / email")
Rel_D(channels, receipts, "Provider receipt", "HTTPS")
Rel(customer, receipts, "Recipient ACK", "HTTPS")
Rel(receipts, ledger, "Receipt + Signal outbox", "SQL")
Rel(receipts, temporal, "Delivery Signal", "gRPC")
Rel(policy, ledger, "Policy / templates", "SQL")
Rel(customer, policy, "Preferences", "HTTPS")
Rel(kafka, campaign, "Noncritical requests", "Kafka protocol")
Rel(campaign, policy, "Check current consent", "HTTPS")
Rel(campaign, ledger, "Attempt / audit", "SQL")
Rel(campaign, channels, "Isolated quotas", "HTTPS")
Rel(workers, obs, "Telemetry", "OTel")
Rel(obs, api, "Query status / audit", "HTTPS")
Lay_D(kafka, campaign)
Lay_R(temporal, workers)
Lay_D(ledger, obs)
SHOW_LEGEND()
@enduml

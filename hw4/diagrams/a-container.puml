@startuml
!pragma layout smetana
!include <C4/C4_Container>
title A — Kafka + PostgreSQL delivery state machine (C4 Container)
LAYOUT_LEFT_RIGHT()
Person(customer, "Customer", "Receives notifications; controls preferences")
System_Ext(bank, "Bank services", "Transfers, purchases, products; source outbox")
System_Ext(channels, "Channel providers", "FCM/APNs, SMS-A / SMS-B, email")
System_Ext(obs, "Operations and support tooling", "Prometheus, Grafana, Loki, Alertmanager; audit views")
System_Boundary(platform, "Notification Platform — option A") {
  Container(api, "Notification API + background Relay", "Go / HTTPS", "One deployable: durable intake, status, outbox publishing")
  ContainerDb(db, "Platform ledger", "PostgreSQL 16 / sync replicas", "Notification, attempts, inbox/outbox, policy, encrypted payload, audit")
  ContainerQueue(kafka, "Class-isolated event streams", "Apache Kafka / RF=3", "critical / service / marketing; commands")
  Container(coordinator, "Delivery Coordinator + Scheduler", "Go", "State transitions, durable due-times, leases, reconcile")
  Container(workers, "Delivery worker", "Go / isolated channel pools", "One deployable type: permits, adapters, send/status")
  Container(receipts, "Receipt API", "Go / HTTPS", "Authenticate callbacks and app ACK; serialize evidence")
  Container(policy, "Policy and template service", "Go / HTTPS", "Preferences, consent, mandatory categories, templates")
  Container(campaign, "Campaign + noncritical workers", "Go", "Batched fanout; consent and frequency checks; separate quotas")
}
Rel_R(bank, api, "Submit / retry", "HTTPS")
Rel_D(api, db, "Intake / status / outbox", "SQL")
Rel_R(api, kafka, "Relay requests + commands", "Kafka protocol")
Rel_R(kafka, coordinator, "Critical requests", "Kafka protocol")
Rel(coordinator, db, "State / due-times", "SQL")
Rel_U(coordinator, policy, "Read policy", "HTTPS")
Rel(kafka, workers, "Send commands", "Kafka protocol")
Rel(workers, db, "Permits / outcomes", "SQL")
Rel_R(workers, channels, "Send / status", "HTTPS")
Rel_R(channels, customer, "Push / SMS / email")
Rel_D(channels, receipts, "Provider receipt", "HTTPS")
Rel(customer, receipts, "Recipient ACK", "HTTPS")
Rel(receipts, db, "Inbox / evidence", "SQL")
Rel(policy, db, "Policy / templates", "SQL")
Rel(customer, policy, "Preferences", "HTTPS")
Rel(kafka, campaign, "Noncritical requests", "Kafka protocol")
Rel(campaign, policy, "Check consent", "HTTPS")
Rel(campaign, db, "Attempt / audit", "SQL")
Rel(campaign, channels, "Noncritical send", "HTTPS")
Rel(coordinator, obs, "Telemetry", "OTel")
Rel(obs, api, "Query status / audit", "HTTPS")
Lay_D(coordinator, workers)
Lay_D(kafka, campaign)
Lay_D(db, obs)
SHOW_LEGEND()
@enduml

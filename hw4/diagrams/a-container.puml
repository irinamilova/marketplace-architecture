@startuml
!pragma layout smetana
!include <C4/C4_Container>
title Вариант A — свой автомат доставки (C4 Container)
LAYOUT_LEFT_RIGHT()
Person(user, "Клиент", "Получает сообщения, выбирает канал")
System_Ext(bank, "Сервисы банка", "Операция и outbox источника")
System_Ext(provider, "Провайдеры", "FCM/APNs, SMS-A, SMS-B, email")
System_Ext(ops, "Поддержка и мониторинг", "История, метрики и оповещения")
System_Boundary(platform, "Платформа уведомлений") {
  Container(api, "API и публикатор", "Go / HTTPS", "Приём, статусы, публикация outbox")
  ContainerQueue(broker, "Очереди по типам", "Kafka / 3 реплики", "Критичные, сервисные, маркетинговые; команды")
  Container(scheduler, "Координатор и планировщик", "Go", "Состояния, сроки и повторы")
  Container(worker, "Обработчик доставки", "Go", "Проверка попытки, отправка и запрос статуса")
  Container(receipt, "Приём подтверждений", "Go / HTTPS", "Проверка и сохранение ACK/DLR")
  Container(policy, "Настройки и шаблоны", "Go / HTTPS", "Каналы, согласия и обязательные категории")
  Container(campaign, "Некритичные рассылки", "Go", "Порции получателей, отдельные квоты")
  ContainerDb(db, "БД платформы", "PostgreSQL 16 / синхронные реплики", "Уведомления, попытки, outbox, настройки, история")
}
Rel_R(bank, api, "Передать событие", "HTTPS")
Rel_D(api, db, "Приём, outbox, статусы", "SQL")
Rel_R(api, broker, "Опубликовать", "Kafka")
Rel_R(broker, scheduler, "Критичное событие", "Kafka")
Rel(scheduler, db, "Состояние и сроки", "SQL")
Rel_U(scheduler, policy, "Выбрать маршрут", "HTTPS")
Rel(broker, worker, "Команда отправки", "Kafka")
Rel(worker, db, "Попытка и результат", "SQL")
Rel_R(worker, provider, "Отправить / проверить", "HTTPS")
Rel_R(provider, user, "Push / SMS / email")
Rel_D(provider, receipt, "Отчёт о доставке", "HTTPS")
Rel(user, receipt, "ACK получателя", "HTTPS")
Rel(receipt, db, "Подтверждение", "SQL")
Rel(policy, db, "Настройки", "SQL")
Rel(user, policy, "Предпочтения", "HTTPS")
Rel(broker, campaign, "Остальные типы", "Kafka")
Rel(campaign, policy, "Проверить согласие", "HTTPS")
Rel(campaign, db, "Попытки и история", "SQL")
Rel(campaign, provider, "Отправить", "HTTPS")
Rel(scheduler, ops, "Метрики", "OTel")
Rel(ops, api, "История доставки", "HTTPS")
Lay_D(scheduler, worker)
Lay_D(broker, campaign)
Lay_D(db, ops)
SHOW_LEGEND()
@enduml
